# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Data — Qdrant storage, BM25 index, originals and extracted figures are
# machine-local, not committed
data/

# Qdrant server binary (~30 MB) — downloaded per platform, see CLAUDE.md
qdrant/

# Secrets / auth state (also covered by data/ above)
data/users.json
data/revocations.json
data/secret.key

# Session notes — AI handoff context, not for version control
handoff.md

# macOS
.DS_Store

# Not part of the app
*.pptx

# Claude Code workspace settings (developer-local, not project config)
.claude/

# Editor
.idea/
.vscode/
*.swp
*.swo

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Tool caches
.ruff_cache/

# Eval output
geo-assist-eval/
data/to_ingest/

# Runtime marker written by the start scripts
.qdrant-initialized
